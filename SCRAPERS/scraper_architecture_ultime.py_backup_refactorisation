                    pourcentage = (total_actuel / total_amazon * 100) if total_amazon > 0 else 0
                    
                    # Calculer estimation temps pour scraping
                    temps_ecoule_str, temps_restant_str = self.calculer_estimation_temps(
                        livres_possedes, total_amazon, self.temps_par_livre_scraping
                    )
                    
                    print(f"📊 Page {page_actuelle} | +{len(nouveaux_livres)} nouveaux livres")
                    print(f"📚 POSSÉDÉS: {livres_possedes:,} livres | À SCRAPER: {livres_restants:,} livres")
                    print(f"🎯 PROGRÈS: {total_actuel:,}/{total_amazon:,} ({pourcentage:.1f}%) | Existants: {len(self.livres_existants):,}")
                    print(f"\033[91m⏱️ TEMPS ÉCOULÉ: {temps_ecoule_str} | TEMPS RESTANT ESTIMÉ: {temps_restant_str}\033[0m")
                    
                    # Affichage stats temps réel AsyncIO
                    self.afficher_stats_temps_reel()
                    
                    # Sauvegarde asynchrone
                    await self.sauvegarder_progres_async(page_actuelle)
                    print(f"Sauvegarde JSON + CSV terminée")
                
                # DÉCOUPAGE AUTOMATIQUE : Sauvegarde toutes les 1000 livres
                if len(self.livres_scraped) - dernier_nombre_livres >= 1000:
                    print(f"📦 DÉCOUPAGE : {len(self.livres_scraped):,} livres atteints - sauvegarde sécurisée")
                    await self.sauvegarder_progres_async(page_actuelle)
                    dernier_nombre_livres = len(self.livres_scraped)
                    print(f"✅ Partie sauvegardée - continuation du scraping...")
                
                # Sauvegarde périodique standard : toutes les 50 pages
                if page_actuelle % 50 == 0:
                    await self.sauvegarder_progres_async(page_actuelle)
                
                page_actuelle += 1
                await asyncio.sleep(random.uniform(0.5, 1.5))
        
        except KeyboardInterrupt:
            print("\n🛑 Arrêt demandé par l'utilisateur")
        
        finally:
            # Sauvegarde finale
            await self.sauvegarder_progres_async(page_actuelle)
            
            # Fermeture des sessions
            for session_info in self.session_pool:
                await session_info['session'].close()
            
            # Sauvegarde finale
            await self.sauvegarder_progres_async(page_actuelle)
            
            # Résultats finaux - ÉPUISEMENT COMPLET DU CATALOGUE
            total_final = stock_existant + len(self.livres_scraped)
            print(f"🏁 ÉPUISEMENT COMPLET AMAZON: {total_final:,} livres récupérés")
            print(f"   (Estimation initiale était: {total_amazon:,} livres)")
            if total_final > total_amazon:
                print(f"   🎉 BONUS: {total_final - total_amazon:,} livres de plus que l'estimation !")
            print(f"   📄 Dernière page traitée: {page_actuelle}")
            print(f"   🛑 Arrêt après {self.pages_vides_consecutives} pages vides consécutives")
            
            # Stats finales détaillées
            temps_total = time.time() - self.stats['start_time']
            print(f"\n🏁 SCRAPING ARCHITECTURE TERMINÉ:")
            print(f"   📚 Total final: {len(self.livres_scraped):,} livres")
            print(f"   ⏱️ Temps total: {self.formater_duree(temps_total)}")
            if temps_total > 0:
                print(f"   🚀 Vitesse moyenne: {len(self.livres_scraped) / temps_total * 60:.1f} livres/minute")
                print(f"   ⚡ Performance AsyncIO: {len(self.livres_scraped) / temps_total:.1f} livres/seconde")
            taux_succes = (self.stats['success_requests'] / self.stats['total_requests'] * 100) if self.stats['total_requests'] > 0 else 0
            print(f"   ✅ Taux de succès: {taux_succes:.1f}%")
            print(f"   🔄 Rotations proxy: {self.stats['proxy_rotations']}")
            print(f"   📊 Sessions AsyncIO utilisées: {len(self.session_pool)}")

    def run(self):
        """Point d'entrée synchrone"""
        try:
            asyncio.run(self.run_async())
        except KeyboardInterrupt:
            print("\n🛑 Arrêt du scraper")
        except Exception as e:
            print(f"❌ Erreur critique: {e}")
            import traceback
            traceback.print_exc()

