    async def calculer_total_reel_amazon_async(self) -> int:
        """Recherche le VRAI nombre de livres Amazon en testant les pages"""
        print("🔍 RECHERCHE NOMBRE RÉEL DE LIVRES AMAZON...")
        
        # Créer une session pour les tests
        if not self.session_pool:
            await self.create_session_pool()
        
        session_info = await self.get_session()
        session = session_info['session']
        
        # Phase 1: Test des pages clés pour avoir une idée de base
        pages_test_initiales = [1, 25, 50, 100, 150, 200]
        derniere_valide = 1
        
        print("🔍 Phase 1: Test pages clés...")
        for page in pages_test_initiales:
            try:
                url_test = f"{self.url_base_recherche}&page={page}"
                async with session.get(url_test, timeout=15) as response:
                    if response.status == 200:
                        html = await response.text()
                        soup = BeautifulSoup(html, 'html.parser')
                        
                        if self.verifier_presence_livres_robuste(soup, page):
                            derniere_valide = page
                            print(f"🎯 Page {page}: VRAIS LIVRES TROUVÉS")
                        else:
