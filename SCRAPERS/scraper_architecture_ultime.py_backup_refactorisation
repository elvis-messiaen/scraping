    async def scraper_batch_async(self, urls: List[str]) -> List[Dict]:
        """Scrape un batch d'URLs en parallèle"""
        tasks = []
        for url in urls:
            if url not in self.urls_scrapees:
                task = asyncio.create_task(self.scraper_livre_async(url))
                tasks.append((task, url))
        
        resultats = []
        if tasks:
            for task, url in tasks:
                try:
                    resultat = await task
                    if resultat:
                        resultats.append(resultat)
                        self.urls_scrapees.add(url)
                except Exception as e:
                    print(f"❌ Erreur task {url[:30]}: {e}")
        
        return resultats

