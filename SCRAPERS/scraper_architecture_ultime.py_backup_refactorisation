    def get_next_proxy_and_ua(self) -> Tuple[Optional[str], str]:
        """Rotation intelligente des proxies et user-agents"""
        if not self.proxies_pool:
            return None, random.choice(self.user_agents)
        
        proxy = None
        max_attempts = len(self.proxies_pool)
        
        for _ in range(max_attempts):
            current_proxy = self.proxies_pool[self.proxy_index % len(self.proxies_pool)]
            proxy_key = current_proxy.get('http', '')
            
            if proxy_key not in self.proxy_failures or \
               time.time() - self.proxy_failures[proxy_key] > 300:
                proxy = proxy_key
                break
            
            self.proxy_index = (self.proxy_index + 1) % len(self.proxies_pool)
        
        user_agent = random.choice(self.user_agents)
        self.proxy_index = (self.proxy_index + 1) % len(self.proxies_pool)
        self.stats['proxy_rotations'] += 1
        
        return proxy, user_agent

    def marquer_proxy_echec(self, proxy_url: str):
        """Marque un proxy comme défaillant"""
        if proxy_url:
            self.proxy_failures[proxy_url] = time.time()

    async def create_session_pool(self):
        """Crée un pool de sessions HTTP optimisées"""
        print(f"🔄 Création pool de {self.max_sessions} sessions AsyncIO...")
        
        for i in range(self.max_sessions):
            timeout = aiohttp.ClientTimeout(
                total=15,
                connect=5,
                sock_read=10
            )
            
            proxy, user_agent = self.get_next_proxy_and_ua()
            headers = {
                'User-Agent': user_agent,
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                'Accept-Language': 'fr-FR,fr;q=0.9,en;q=0.8',
                'Accept-Encoding': 'gzip, deflate, br',
                'DNT': '1',
                'Connection': 'keep-alive',
                'Upgrade-Insecure-Requests': '1',
                'Sec-Fetch-Dest': 'document',
                'Sec-Fetch-Mode': 'navigate',
                'Sec-Fetch-Site': 'none',
                'Cache-Control': 'max-age=0'
            }
            
            connector = aiohttp.TCPConnector(
                limit=30,
                limit_per_host=10,
                keepalive_timeout=30,
                enable_cleanup_closed=True,
                ssl=False
            )
            
            session = aiohttp.ClientSession(
                timeout=timeout,
                headers=headers,
                connector=connector,
                trust_env=True
            )
            
            self.session_pool.append({
                'session': session,
                'proxy': proxy,
                'user_agent': user_agent,
                'requests_count': 0
            })
        
        print(f"✅ Pool créé: {len(self.session_pool)} sessions avec rotation proxy/UA")

    async def get_session(self) -> Dict:
        """Récupère une session optimale du pool avec rotation"""
        if not self.session_pool:
            await self.create_session_pool()
        
        session_info = min(self.session_pool, key=lambda x: x['requests_count'])
        session_info['requests_count'] += 1
        
        if session_info['requests_count'] % self.config['delais_optimaux']['proxy_rotation'] == 0:
            new_proxy, new_ua = self.get_next_proxy_and_ua()
            session_info['proxy'] = new_proxy
            session_info['user_agent'] = new_ua
            session_info['session']._default_headers['User-Agent'] = new_ua
        
        return session_info

    async def scraper_livre_async(self, url: str) -> Optional[Dict]:
        """Scrape un livre avec AsyncIO ultra-rapide"""
        async with self.semaphore:
            debut = time.time()
            session_info = await self.get_session()
            session = session_info['session']
            proxy = session_info['proxy']
            
            try:
                await asyncio.sleep(random.uniform(
                    self.config['delais_optimaux']['min_delay'],
                    self.config['delais_optimaux']['max_delay']
                ))
                
                proxy_config = None
                if proxy:
                    proxy_config = proxy
                
                headers_request = {
                    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                    'Accept-Language': 'fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7',
                    'Accept-Encoding': 'gzip, deflate, br',
                    'Cache-Control': 'no-cache',
                    'Pragma': 'no-cache',
                    'Sec-Fetch-Dest': 'document',
                    'Sec-Fetch-Mode': 'navigate',
                    'Sec-Fetch-Site': 'none',
                    'Upgrade-Insecure-Requests': '1'
                }
                
                for attempt in range(3):
                    try:
                        async with session.get(url, proxy=proxy_config, headers=headers_request, timeout=15) as response:
                            if response.status == 200:
                                html = await response.text()
                                break
                            elif response.status == 503:
                                wait_time = random.uniform(2, 5) * (attempt + 1)
                                print(f"⚠️ Status 503 - attente {wait_time:.1f}s (tentative {attempt+1})")
                                await asyncio.sleep(wait_time)
                                continue
                            elif response.status == 429:
                                wait_time = random.uniform(5, 10) * (attempt + 1)
                                print(f"⚠️ Rate limit 429 - attente {wait_time:.1f}s (tentative {attempt+1})")
                                await asyncio.sleep(wait_time)
                                continue
                            else:
                                print(f"❌ Status {response.status} pour {url[:50]}")
                                return None
                    except asyncio.TimeoutError:
                        print(f"⏱️ Timeout {url[:50]} (tentative {attempt+1})")
                        if attempt == 0:
                            await asyncio.sleep(1)
                            continue
                        return None
                    except Exception as e:
                        if "proxy" in str(e).lower() and proxy:
                            self.marquer_proxy_echec(proxy)
                        print(f"❌ Erreur réseau {url[:50]}: {e}")
                        return None
                
                self.stats['total_requests'] += 1
                self.stats['success_requests'] += 1
                
                soup = BeautifulSoup(html, 'html.parser')
                donnees_livre = await self.extraire_donnees_livre(soup, url)
                
                temps_livre = time.time() - debut
                self.temps_par_livre_scraping.append(temps_livre)
                
                temps_total = time.time() - self.stats['start_time']
                if temps_total > 0:
                    self.stats['livres_per_second'] = self.stats['success_requests'] / temps_total
                
                return donnees_livre
                
            except Exception as e:
                self.stats['failed_requests'] += 1
                if proxy:
                    self.marquer_proxy_echec(proxy)
                print(f"❌ Erreur scraping {url[:50]}: {e}")
                return None

