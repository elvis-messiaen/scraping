                            break
                    else:
                        print(f"❌ Page {page}: Status {response.status}")
                        break
                        
                await asyncio.sleep(0.5)  # Délai entre tests
                
            except Exception as e:
                print(f"❌ Erreur page {page}: {e}")
                break
        
        # Phase 2: Si on a trouvé des livres au-delà de page 200, recherche étendue
        if derniere_valide >= 200:
            print("🔍 Phase 2: Recherche étendue...")
            pages_vides_consecutives = 0
            page_courante = derniere_valide + 10  # Sauter par 10
            
            while pages_vides_consecutives < 3:  # AUCUNE LIMITE de pages
                try:
                    url_test = f"{self.url_base_recherche}&page={page_courante}"
                    async with session.get(url_test, timeout=15) as response:
                        if response.status == 200:
                            html = await response.text()
