            self.temps_derniere_metrique = self.debut_scraping
        
        maintenant = datetime.now()
        temps_ecoule = (maintenant - self.debut_scraping).total_seconds()
        livres_possedes = len(self.livres_scraped)
        
        # Vitesse actuelle (livres/seconde)
        if temps_ecoule > 0:
            vitesse_moyenne = livres_possedes / temps_ecoule
            self.historique_vitesse.append(vitesse_moyenne)
            
            # Garder seulement les 10 dernières mesures pour vitesse actuelle
