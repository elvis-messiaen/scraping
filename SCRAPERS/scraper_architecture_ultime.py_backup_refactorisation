        print(f"\033[92m⚡ STATS ULTRA-RAPIDE:\033[0m")
        print(f"   📊 Requêtes: {self.stats['total_requests']} | Succès: {taux_succes:.1f}%")
        print(f"   🚀 Vitesse: {self.stats['livres_per_second']:.1f} livres/seconde")
        print(f"   🔄 Rotations proxy: {self.stats['proxy_rotations']}")
        print(f"   ⏱️ Temps total: {self.formater_duree(temps_total)}")

