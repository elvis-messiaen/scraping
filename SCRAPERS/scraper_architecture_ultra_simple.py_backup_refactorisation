    async def create_session_pool(self):
        """Crée un pool de sessions HTTP ultra-simple"""
        print(f"🔄 Création pool de {self.max_sessions} sessions...")
        
        for i in range(self.max_sessions):
            timeout = aiohttp.ClientTimeout(total=20, connect=8)
            
            headers = {
                'User-Agent': random.choice(self.user_agents),
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                'Accept-Language': 'fr-FR,fr;q=0.9,en;q=0.8',
                'Accept-Encoding': 'gzip, deflate',
                'Connection': 'keep-alive',
                'Upgrade-Insecure-Requests': '1'
            }
            
            connector = aiohttp.TCPConnector(
                limit=20,
                limit_per_host=8,
                keepalive_timeout=30
            )
            
            session = aiohttp.ClientSession(
                timeout=timeout,
                headers=headers,
                connector=connector
            )
            
            self.session_pool.append({
                'session': session,
                'requests_count': 0
            })
        
        print(f"✅ Pool créé: {len(self.session_pool)} sessions")

    async def get_session(self) -> Dict:
        """Récupère une session du pool"""
        if not self.session_pool:
            await self.create_session_pool()
        
        # Prendre la session avec le moins de requêtes
        session_info = min(self.session_pool, key=lambda x: x['requests_count'])
        session_info['requests_count'] += 1
        
        return session_info

    async def scraper_page_simple(self, page_num: int) -> List[str]:
        """Scrape une page - VERSION ULTRA-SIMPLE qui fonctionne"""
        url_page = f"{self.url_base_recherche}&page={page_num}"
        
        session_info = await self.get_session()
        session = session_info['session']
        
        try:
            async with session.get(url_page, timeout=20) as response:
                if response.status != 200:
                    print(f"❌ Page {page_num}: Status {response.status}")
                    return []
                
                html = await response.text()
                soup = BeautifulSoup(html, 'html.parser')
                
                # SÉLECTEURS TESTÉS ET VALIDÉS - SIMPLIFIÉS
                liens_livres = []
                liens_vus = set()
                
                # Méthode 1: Tous les liens avec /dp/ (le plus fiable)
                all_links = soup.find_all('a', href=True)
                for link in all_links:
                    href = link.get('href', '')
                    if '/dp/' in href:
                        # Nettoyer l'URL
                        if href.startswith('/'):
                            url_complete = 'https://www.amazon.fr' + href
                        else:
                            url_complete = href
                        
                        # Extraire juste l'ID du produit pour éviter les doublons
                        if '/dp/' in url_complete:
                            dp_index = url_complete.find('/dp/')
                            if dp_index != -1:
                                # Prendre /dp/ + 10 caractères (ID produit standard Amazon)
                                base_url = url_complete[:dp_index + 14]
                                if base_url not in liens_vus and 'amazon.fr' in base_url:
                                    liens_livres.append(url_complete)
                                    liens_vus.add(base_url)
                
                print(f"📄 Page {page_num}: {len(liens_livres)} livres trouvés")
                
                # Si on trouve moins de 5 livres, considérer comme page vide
                if len(liens_livres) < 5:
                    print(f"⚠️ Page {page_num}: Seulement {len(liens_livres)} livres - possiblement fin de catalogue")
                
                return liens_livres
                
        except Exception as e:
            print(f"❌ Erreur page {page_num}: {e}")
            return []

    async def scraper_livre_simple(self, url: str) -> Optional[Dict]:
        """Scrape un livre - VERSION SIMPLE ET RAPIDE"""
        async with self.semaphore:
            debut = time.time()
            session_info = await self.get_session()
            session = session_info['session']
            
            try:
                # Délai minimal
                await asyncio.sleep(random.uniform(0.1, 0.3))
                
                async with session.get(url, timeout=15) as response:
                    if response.status != 200:
                        self.stats['failed_requests'] += 1
                        return None
                    
                    html = await response.text()
                    soup = BeautifulSoup(html, 'html.parser')
                    
                    self.stats['total_requests'] += 1
                    self.stats['success_requests'] += 1
                    
                    # Extraction SIMPLE des données essentielles
                    donnees_livre = {
                        'url': url,
                        'timestamp': datetime.now().isoformat(),
                        'categorie': self.nom_categorie,
                        'titre': '',
                        'auteur': '',
                        'isbn': '',
                        'editeur': '',
                        'pages': '',
                        'langue': '',
                        'date_publication': '',
                        'prix_actuel': '',
                        'description_longue': '',
                        'note_moyenne': '',
                        'nombre_avis': '',
                        'image_url': '',
                        'categories_breadcrumb': []
                    }
                    
                    # Titre - sélecteurs simples
                    titre_elem = soup.select_one('#productTitle') or soup.select_one('h1')
                    if titre_elem:
                        donnees_livre['titre'] = titre_elem.get_text().strip()
                    
                    # Auteur
                    auteur_links = soup.select('.author a, #bylineInfo a')
                    auteurs = []
                    for link in auteur_links[:3]:  # Max 3 auteurs
                        auteur_text = link.get_text().strip()
                        if auteur_text and len(auteur_text) > 1:
                            auteurs.append(auteur_text)
                    donnees_livre['auteur'] = ', '.join(auteurs)
                    
                    # Prix
                    prix_elem = soup.select_one('.a-price .a-offscreen') or soup.select_one('.a-color-price')
                    if prix_elem:
                        prix_text = prix_elem.get_text().strip()
                        if '€' in prix_text:
                            donnees_livre['prix_actuel'] = prix_text
                    
                    # Image
                    img_elem = soup.select_one('#landingImage') or soup.select_one('.a-dynamic-image')
                    if img_elem and img_elem.get('src'):
                        donnees_livre['image_url'] = img_elem.get('src')
                    
                    # ISBN rapide via regex
                    page_text = soup.get_text()
                    isbn_match = re.search(r'ISBN[^:]*:\s*([A-Z0-9-]{10,17})', page_text, re.IGNORECASE)
                    if isbn_match:
                        donnees_livre['isbn'] = isbn_match.group(1)
                    
                    # Description simple
                    desc_elem = soup.select_one('#feature-bullets') or soup.select_one('#bookDescription_feature_div')
                    if desc_elem:
                        desc_text = desc_elem.get_text().strip()
                        if len(desc_text) > 20:
                            donnees_livre['description_longue'] = desc_text[:500]
                    
                    # Temps de traitement
                    temps_livre = time.time() - debut
                    self.temps_par_livre_scraping.append(temps_livre)
                    
                    # Affichage
                    titre_court = donnees_livre['titre'][:40] + "..." if len(donnees_livre['titre']) > 40 else donnees_livre['titre']
                    print(f"⚡ SCRAPE: {titre_court}")
                    
                    return donnees_livre
                    
            except Exception as e:
                self.stats['failed_requests'] += 1
                print(f"❌ Erreur livre {url[:40]}: {e}")
                return None

    async def scraper_batch_simple(self, urls: List[str]) -> List[Dict]:
        """Scrape un batch d'URLs en parallèle"""
        tasks = []
        for url in urls:
            if url not in self.urls_scrapees:
                task = asyncio.create_task(self.scraper_livre_simple(url))
                tasks.append((task, url))
        
        resultats = []
        for task, url in tasks:
            try:
                resultat = await task
                if resultat:
                    resultats.append(resultat)
                    self.urls_scrapees.add(url)
            except Exception as e:
                print(f"❌ Erreur task: {e}")
        
        return resultats

    def creer_dossiers(self):
        """Crée les dossiers nécessaires"""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        os.makedirs(dossier_livres, exist_ok=True)

    def charger_progres(self):
        """Charge les livres existants"""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        
        if os.path.exists(dossier_livres):
            fichiers_json = [f for f in os.listdir(dossier_livres) if f.endswith('.json') and 'progres' not in f]
            for fichier in fichiers_json:
                chemin = os.path.join(dossier_livres, fichier)
                try:
                    with open(chemin, 'r', encoding='utf-8') as f:
                        livres = json.load(f)
                        if isinstance(livres, list):
                            for livre in livres:
                                url = livre.get('url')
                                if url and livre.get('titre'):
                                    self.livres_scraped.append(livre)
                                    self.urls_scrapees.add(url)
                                    self.index_by_url[url] = len(self.livres_scraped) - 1
                                    self.livres_existants[url] = livre
                            print(f"📚 Chargé: {len(livres)} livres depuis {fichier}")
                except Exception as e:
                    print(f"❌ Erreur lecture {chemin}: {e}")
        
        print(f"📚 Total chargé: {len(self.livres_scraped)} livres existants")

    async def sauvegarder_progres_simple(self):
        """Sauvegarde simple et efficace"""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        
        if self.livres_scraped:
            # JSON
            fichier_json = os.path.join(dossier_livres, f"{self.nom_fichier}_livres.json")
            try:
                async with aiofiles.open(fichier_json, 'w', encoding='utf-8') as f:
                    await f.write(json.dumps(self.livres_scraped, ensure_ascii=False, indent=2))
                print(f"💾 JSON sauvé: {len(self.livres_scraped)} livres")
            except Exception as e:
                print(f"❌ Erreur JSON: {e}")
            
            # CSV
            try:
                fichier_csv = os.path.join(dossier_livres, f"{self.nom_fichier}_livres.csv")
                df = pd.DataFrame(self.livres_scraped)
                df.to_csv(fichier_csv, index=False)
                print(f"💾 CSV sauvé: {len(self.livres_scraped)} livres")
            except Exception as e:
                print(f"❌ Erreur CSV: {e}")

    def formater_duree(self, secondes: float) -> str:
        """Formate une durée"""
        if secondes < 60:
            return f"{secondes:.1f}s"
        elif secondes < 3600:
            minutes = int(secondes // 60)
            sec = secondes % 60
            return f"{minutes}m {sec:.0f}s"
        else:
            heures = int(secondes // 3600)
            minutes = int((secondes % 3600) // 60)
            return f"{heures}h {minutes}m"

    def calculer_estimation_temps(self, livres_traites: int, total_livres: int) -> Tuple[str, str]:
        """Calcule l'estimation de temps"""
        if not self.temps_par_livre_scraping or livres_traites == 0:
            return "Calcul...", "Calcul..."
        
        temps_moyen = sum(self.temps_par_livre_scraping[-20:]) / len(self.temps_par_livre_scraping[-20:])
        temps_ecoule = time.time() - self.stats['start_time']
        livres_restants = total_livres - livres_traites
        temps_restant = livres_restants * temps_moyen
        
        return self.formater_duree(temps_ecoule), self.formater_duree(temps_restant)

    def afficher_stats_temps_reel(self):
        """Affiche les stats"""
        temps_total = time.time() - self.stats['start_time']
        if temps_total > 0:
            self.stats['livres_per_second'] = self.stats['success_requests'] / temps_total
        
        taux_succes = (self.stats['success_requests'] / self.stats['total_requests'] * 100) if self.stats['total_requests'] > 0 else 0
        
        print(f"\033[92m⚡ STATS ULTRA-RAPIDE:\033[0m")
        print(f"   📊 Requêtes: {self.stats['total_requests']} | Succès: {taux_succes:.1f}%")
        print(f"   🚀 Vitesse: {self.stats['livres_per_second']:.1f} livres/seconde")
        print(f"   ⏱️ Temps total: {self.formater_duree(temps_total)}")

    async def run_simple(self):
        """Fonction principale ultra-simple"""
        print("🚀 DÉMARRAGE SCRAPER ARCHITECTURE ULTRA-SIMPLE")
        print("=" * 60)
        
        self.stats['start_time'] = time.time()
        self.temps_debut_scraping = time.time()
        
        # 1. Calcul du total Amazon réel
        total_amazon_actuel = self.detecter_total_amazon_reel()
        print(f"Total Amazon calculé: {total_amazon_actuel:,} livres")
        
        # 2. État actuel
        stock_existant = len(self.livres_existants)
        livres_charges = len(self.livres_scraped)
        
        print(f"État actuel:")
        print(f"   Livres existants:    {stock_existant:,} livres")
        print(f"   Chargés en mémoire: {livres_charges:,} livres")
        print(f"   Amazon total:       {total_amazon_actuel:,} livres")
        print(f"   OBJECTIF: Scraper Amazon + mettre à jour {livres_charges:,} existants")
        
        # 3. Créer le pool de sessions
        await self.create_session_pool()
        
        # 4. Scraping principal
        print("🔄 DÉMARRAGE SCRAPING AMAZON")
        page_actuelle = 1
        nouveaux_livres_session = 0
        
        try:
            while nouveaux_livres_session < (total_amazon_actuel - len(self.livres_scraped)) and page_actuelle <= 200:
                # Récupérer URLs de la page
                urls_page = await self.scraper_page_simple(page_actuelle)
                
                if not urls_page or len(urls_page) < 5:
                    self.pages_vides_consecutives += 1
                    print(f"❌ Page {page_actuelle}: Peu/pas de livres ({len(urls_page)}) - {self.pages_vides_consecutives}/{self.max_pages_vides}")
                    
                    if self.pages_vides_consecutives >= self.max_pages_vides:
                        print(f"🛑 ARRÊT: {self.max_pages_vides} pages vides consécutives")
                        break
                    
                    page_actuelle += 1
                    await asyncio.sleep(2)  # Attendre plus longtemps
                    continue
                
                # Reset compteur
                self.pages_vides_consecutives = 0
                
                # Scraper les livres
                nouveaux_livres = await self.scraper_batch_simple(urls_page)
                
                if nouveaux_livres:
                    self.livres_scraped.extend(nouveaux_livres)
                    nouveaux_livres_session += len(nouveaux_livres)
                    
                    # Mise à jour index
                    for livre in nouveaux_livres:
                        url = livre.get('url')
                        if url:
                            self.index_by_url[url] = len(self.livres_scraped) - 1
                    
                    # **AFFICHAGE MÉTRIQUES COMPLÈTES COMME DEMANDÉ**
                    livres_possedes = len(self.livres_scraped)
                    livres_restants = total_amazon_actuel - livres_possedes
                    total_actuel = stock_existant + len(self.livres_scraped)
                    pourcentage = (total_actuel / total_amazon_actuel * 100) if total_amazon_actuel > 0 else 0
                    
                    # Calcul estimation temps
                    temps_ecoule_str, temps_restant_str = self.calculer_estimation_temps(
                        livres_possedes, total_amazon_actuel
                    )
                    
                    print(f"\n📊 Page {page_actuelle} | +{len(nouveaux_livres)} nouveaux livres")
                    print(f"📚 POSSÉDÉS: {livres_possedes:,} livres | À SCRAPER: {livres_restants:,} livres")
                    print(f"🎯 PROGRÈS: {total_actuel:,}/{total_amazon_actuel:,} ({pourcentage:.1f}%) | Existants: {len(self.livres_existants):,}")
                    print(f"\033[91m⏱️ TEMPS ÉCOULÉ: {temps_ecoule_str} | TEMPS RESTANT ESTIMÉ: {temps_restant_str}\033[0m")
                    
                    # Stats temps réel
                    self.afficher_stats_temps_reel()
                    
                    # Sauvegarde
                    await self.sauvegarder_progres_simple()
                    print("Sauvegarde JSON + CSV terminée")
                
                # Sauvegarde périodique
                if page_actuelle % 10 == 0:
                    await self.sauvegarder_progres_simple()
                
                page_actuelle += 1
                await asyncio.sleep(random.uniform(1, 2))
        
        except KeyboardInterrupt:
            print("\n🛑 Arrêt demandé")
        
        finally:
            # Sauvegarde finale
            await self.sauvegarder_progres_simple()
            
            # Fermeture sessions
            for session_info in self.session_pool:
                await session_info['session'].close()
            
            # **STATS FINALES COMPLÈTES**
            total_final = stock_existant + len(self.livres_scraped)
            if total_final >= total_amazon_actuel:
                print(f"OBJECTIF ATTEINT: {total_final:,}/{total_amazon_actuel:,} livres")
            else:
                print(f"ARRÊT: {total_final:,}/{total_amazon_actuel:,} livres")
            
            temps_total = time.time() - self.stats['start_time']
            print(f"\n🏁 SCRAPING ARCHITECTURE TERMINÉ:")
            print(f"   📚 Total final: {len(self.livres_scraped):,} livres")
            print(f"   ⏱️ Temps total: {self.formater_duree(temps_total)}")
            if temps_total > 0:
                print(f"   🚀 Vitesse moyenne: {len(self.livres_scraped) / temps_total * 60:.1f} livres/minute")
                print(f"   ⚡ Performance AsyncIO: {len(self.livres_scraped) / temps_total:.1f} livres/seconde")
            
            taux_succes = (self.stats['success_requests'] / self.stats['total_requests'] * 100) if self.stats['total_requests'] > 0 else 0
            print(f"   ✅ Taux de succès: {taux_succes:.1f}%")

    def run(self):
        """Point d'entrée"""
        try:
            asyncio.run(self.run_simple())
        except KeyboardInterrupt:
            print("\n🛑 Arrêt du scraper")
        except Exception as e:
            print(f"❌ Erreur: {e}")
            import traceback
            traceback.print_exc()

