class ScraperAmazonAstronomie:
    def __init__(self):
        self.nom_categorie = "Astronomie"
        self.nom_fichier = "astronomie"
        self.url_base_recherche = "https://www.amazon.fr/s?k=astronomie&i=stripbooks"
        self.total_amazon_estime = 0  # Sera détecté automatiquement
        
        # Configuration optimisée pour performance (comme scraper_ados)
        self.max_workers = 15  # Augmenté grâce aux optimisations    # 200 workers parallèles comme scraper_ados
        self.pool_size = 15      # 50 drivers physiques comme scraper_ados  
        self.request_delay = 0.1  # Réduit grâce au cache # Délai optimisé comme scraper_ados
        
        # Thread safety
        self.lock = threading.Lock()
        
        # Optimiseur APIs gratuites
        if APIS_DISPONIBLES:
            self.optimiseur = APIGratuitesOptimiseur()
            config = obtenir_config_ultra_rapide()
            print("🚀 Optimisations activées: cache, proxies rotatifs, headers aléatoires")
        else:
            self.optimiseur = None
        
        # Collections thread-safe
        self.livres_scraped = []
        self.livres_existants = {}
        self.urls_scrapees = set()
        self.index_by_url = {}
        self.index_by_isbn = {}
        
        # Pool de drivers
        self.drivers_pool = []
        
        # Driver principal pour navigation
        self.driver = None
        
        # Proxies (optionnel)
        self.proxies = []
        self.current_proxy_index = 0
        
        # Compteurs pour système de 3 tentatives
        self.pages_vides_consecutives = 0
        self.max_pages_vides = 3
        
        # Créer dossiers
        self.creer_dossiers()
        
        # Charger données existantes
        self.charger_progres()
    
    def creer_dossiers(self):
        """Crée les dossiers nécessaires"""
        # Obtenir le chemin absolu du répertoire de base (dossier parent de SCRAPERS)
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        os.makedirs(dossier_livres, exist_ok=True)
    
    def get_next_proxy(self):
        """Rotation des proxies (si disponibles)"""
        self.proxies = []  # DÉSACTIVÉ: Proxies causent des erreurs de connexion
            return None
        proxy = self.proxies[self.current_proxy_index % len(self.proxies)]
        self.current_proxy_index += 1
        return proxy
    
    def rebuild_indexes(self):
        """Reconstruit les index (URL / ISBN) à partir de self.livres_scraped."""
        self.index_by_url = {}
        self.index_by_isbn = {}
        self.urls_scrapees = set()
        for idx, item in enumerate(self.livres_scraped):
            url = item.get('url')
            isbn = item.get('isbn')
            if url:
                self.index_by_url[url] = idx
                self.urls_scrapees.add(url)
            if isbn:
                self.index_by_isbn[isbn] = idx

    def charger_progres(self):
        """Charge les livres existants depuis LIVRES/ et AMAZON_LIVRES_COMPLET/ et complet_livres.json"""
        # 1. Priorité: Charger depuis LIVRES/astronomie/
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        if os.path.exists(dossier_livres):
            fichiers_json = [f for f in os.listdir(dossier_livres) if f.endswith('.json') and 'progres' not in f]
            if fichiers_json:
                for fichier in fichiers_json:
                    chemin_fichier = os.path.join(dossier_livres, fichier)
                    try:
                        with open(chemin_fichier, 'r', encoding='utf-8') as f:
                            livres = json.load(f)
                            if isinstance(livres, list) and livres:
                                livres_valides = 0
                                for livre in livres:
                                    url = livre.get('url', '')
                                    if url and livre.get('titre'):  # Vérifier titre aussi
                                        self.livres_existants[url] = livre
                                        livres_valides += 1
                                print(f"Chargement LIVRES/{self.nom_fichier}: {livres_valides} livres VALIDES depuis {fichier} (sur {len(livres)} total)")
                    except Exception as e:
                        print(f"Erreur chargement {chemin_fichier}: {e}")
            else:
                print(f"Aucun fichier de livres trouvé dans LIVRES/{self.nom_fichier}/")
        
        # 2. Compléter avec complet_livres.json
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        complet_path = os.path.join(base_dir, 'complet_livres.json')
        if os.path.exists(complet_path):
            try:
                with open(complet_path, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    livres_categorie = [livre for livre in data if livre.get('categorie') == self.nom_categorie]
                    nouveaux = 0
                    for livre in livres_categorie:
                        url = livre.get('url', '')
                        if url and url not in self.livres_existants:
                            self.livres_existants[url] = livre
                            nouveaux += 1
                    if nouveaux > 0:
                        print(f"Ajout {nouveaux} livres depuis complet_livres.json")
            except Exception as e:
                print(f"Erreur lecture complet_livres.json: {e}")
        
        # 3. DEBUG: Vérifier ce qui est réellement dans livres_existants
        print(f"🔍 DEBUG livres_existants: {len(self.livres_existants)} entrées")
        
        # 4. CORRECTION: Prendre seulement les livres RÉELS pour mise à jour
        livres_reels = 0
        for url, livre in self.livres_existants.items():
            if livre.get('titre') and livre.get('url'):  # Vérifier que c'est un vrai livre
                self.livres_scraped.append(livre)
                livres_reels += 1
            else:
                print(f"⚠️ Livre invalide ignoré: {url[:50]}")
        
        print(f"🔄 MODE MISE À JOUR ACTIVÉ: {livres_reels} livres VALIDES chargés pour mise à jour")
        
        # 5. Rebuild des index
        self.rebuild_indexes()
        
        print(f"CHARGEMENT TERMINÉ: {len(self.livres_scraped):,} livres valides en mémoire")

    def sauvegarder_progres_complet(self, page_actuelle: int, total_amazon_actuel: int):
        """Sauvegarde complète: JSON + CSV + progrès"""
        # Obtenir le chemin absolu du répertoire de base (dossier parent de SCRAPERS)
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        
        print(f"DEBUG: Tentative de sauvegarde de {len(self.livres_scraped)} livres dans {dossier_livres}")
        
        # 1. Sauvegarde JSON principale
        fichier_json = os.path.join(dossier_livres, f"{self.nom_fichier}_livres.json")
        try:
            with open(fichier_json, 'w', encoding='utf-8') as f:
                json.dump(self.livres_scraped, f, ensure_ascii=False, indent=2)
            print(f"✅ Sauvegarde JSON réussie: {fichier_json}")
        except Exception as e:
            print(f"❌ Erreur sauvegarde JSON: {e}")
        
        # 2. Sauvegarde CSV
        if self.livres_scraped:
            fichier_csv = os.path.join(dossier_livres, f"{self.nom_fichier}_livres.csv")
            try:
                df = pd.DataFrame(self.livres_scraped)
                df.to_csv(fichier_csv, index=False)
                print(f"✅ Sauvegarde CSV réussie: {fichier_csv}")
            except Exception as e:
                print(f"❌ Erreur sauvegarde CSV: {e}")
        else:
            print("⚠️ Aucune donnée à sauvegarder en CSV")
        
        # 3. Sauvegarde progrès
        progres = {
            'page_actuelle': page_actuelle,
            'total_scrappe': len(self.livres_scraped),
            'total_tous_livres': len(self.livres_existants) + len(self.livres_scraped),
            'total_objectif': total_amazon_actuel,
            'pourcentage': (len(self.livres_scraped) / total_amazon_actuel * 100) if total_amazon_actuel > 0 else 0,
            'derniere_sauvegarde': datetime.now().isoformat()
        }
        
        chemin_progres = os.path.join(dossier_livres, f"{self.nom_fichier}_progres.json")
        try:
            with open(chemin_progres, 'w', encoding='utf-8') as f:
                json.dump(progres, f, ensure_ascii=False, indent=2)
            print(f"✅ Sauvegarde progrès réussie: {chemin_progres}")
        except Exception as e:
            print(f"❌ Erreur sauvegarde progrès: {e}")


    def charger_page_debut(self) -> int:
        """Retourne la page de reprise si disponible."""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        chemin_progres = os.path.join(base_dir, 'LIVRES', self.nom_fichier, f"{self.nom_fichier}_progres.json")
        if os.path.exists(chemin_progres):
            try:
                with open(chemin_progres, 'r', encoding='utf-8') as f:
                    progres = json.load(f)
                    # Si on n'a aucun livre, recommencer à 1
                    if progres.get('total_scrappe', 0) == 0 and progres.get('total_tous_livres', 0) == 0:
                        return 1
                    return int(progres.get('page_actuelle', 1))
            except Exception:
                return 1
        return 1

