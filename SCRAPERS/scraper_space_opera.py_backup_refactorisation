        print(f"   ⚡ Mise à jour des informations (prix, stock, nouveaux détails)")
        
        livres_mis_a_jour = 0
        batch_size = 20
        
        for i in range(0, len(self.livres_scraped), batch_size):
            batch = self.livres_scraped[i:i + batch_size]
            print(f"   🔄 Batch {i//batch_size + 1}/{(len(self.livres_scraped) + batch_size - 1)//batch_size}")
            
            for j, livre in enumerate(batch):
