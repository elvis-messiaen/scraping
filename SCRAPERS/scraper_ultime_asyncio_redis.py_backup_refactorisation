    def get_next_proxy_and_ua(self) -> Tuple[Optional[str], str]:
        """Rotation intelligente des proxies et user-agents"""
        if not self.proxies_pool:
            # Sans proxy - juste user-agent aléatoire
            return None, random.choice(self.user_agents)
        
        # Avec proxies - rotation intelligente
        proxy = None
        max_attempts = len(self.proxies_pool)
        
        for _ in range(max_attempts):
            current_proxy = self.proxies_pool[self.proxy_index % len(self.proxies_pool)]
            proxy_key = current_proxy.get('http', '')
            
            # Vérifier si ce proxy a échoué récemment
            if proxy_key not in self.proxy_failures or \
               time.time() - self.proxy_failures[proxy_key] > 300:  # 5 min de cooldown
                proxy = proxy_key
                break
            
            self.proxy_index = (self.proxy_index + 1) % len(self.proxies_pool)
        
        # Rotation user-agent
        user_agent = random.choice(self.user_agents)
        
        # Incrémenter pour prochaine fois
        self.proxy_index = (self.proxy_index + 1) % len(self.proxies_pool)
        self.stats['proxy_rotations'] += 1
        
        return proxy, user_agent

    def marquer_proxy_echec(self, proxy_url: str):
        """Marque un proxy comme défaillant"""
        if proxy_url:
            self.proxy_failures[proxy_url] = time.time()

    async def create_session_pool(self):
        """Crée un pool de sessions HTTP optimisées"""
        print(f"🔄 Création pool de {self.max_sessions} sessions AsyncIO...")
        
        for i in range(self.max_sessions):
            # Configuration optimale pour chaque session
            timeout = aiohttp.ClientTimeout(
                total=15,      # Timeout total de 15s
                connect=5,     # Timeout connexion de 5s
                sock_read=10   # Timeout lecture de 10s
            )
            
            # Headers anti-détection
            proxy, user_agent = self.get_next_proxy_and_ua()
            headers = {
                'User-Agent': user_agent,
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                'Accept-Language': 'fr-FR,fr;q=0.9,en;q=0.8',
                'Accept-Encoding': 'gzip, deflate, br',
                'DNT': '1',
                'Connection': 'keep-alive',
                'Upgrade-Insecure-Requests': '1',
                'Sec-Fetch-Dest': 'document',
                'Sec-Fetch-Mode': 'navigate',
                'Sec-Fetch-Site': 'none',
                'Cache-Control': 'max-age=0'
            }
            
            # Configuration avancée SSL et connexions
            connector = aiohttp.TCPConnector(
                limit=30,           # Max 30 connexions par session
                limit_per_host=10,  # Max 10 par host
                keepalive_timeout=30,
                enable_cleanup_closed=True,
                ssl=False  # Désactiver SSL pour plus de vitesse si nécessaire
            )
            
            session = aiohttp.ClientSession(
                timeout=timeout,
                headers=headers,
                connector=connector,
                trust_env=True  # Utiliser variables d'environnement pour proxies
            )
            
            self.session_pool.append({
                'session': session,
                'proxy': proxy,
                'user_agent': user_agent,
                'requests_count': 0
            })
        
        print(f"✅ Pool créé: {len(self.session_pool)} sessions avec rotation proxy/UA")

    async def get_session(self) -> Dict:
        """Récupère une session optimale du pool avec rotation"""
        if not self.session_pool:
            await self.create_session_pool()
        
        # Prendre la session avec le moins de requêtes
        session_info = min(self.session_pool, key=lambda x: x['requests_count'])
        session_info['requests_count'] += 1
        
        # Rotation périodique des proxies/UA
        if session_info['requests_count'] % self.config['delais_optimaux']['proxy_rotation'] == 0:
            new_proxy, new_ua = self.get_next_proxy_and_ua()
            session_info['proxy'] = new_proxy
            session_info['user_agent'] = new_ua
            # Mise à jour du header User-Agent
            session_info['session']._default_headers['User-Agent'] = new_ua
        
        return session_info

    async def scraper_livre_async(self, url: str) -> Optional[Dict]:
        """Scrape un livre avec AsyncIO ultra-rapide"""
        async with self.semaphore:  # Limite la concurrence
            debut = time.time()
            session_info = await self.get_session()
            session = session_info['session']
            proxy = session_info['proxy']
            
            try:
                # Délai minimal aléatoire pour éviter détection
                await asyncio.sleep(random.uniform(
                    self.config['delais_optimaux']['min_delay'],
                    self.config['delais_optimaux']['max_delay']
                ))
                
                # Configuration proxy pour cette requête
                proxy_config = None
                if proxy:
                    proxy_config = proxy
                
                # Headers anti-503 Amazon
                headers_request = {
                    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                    'Accept-Language': 'fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7',
                    'Accept-Encoding': 'gzip, deflate, br',
                    'Cache-Control': 'no-cache',
                    'Pragma': 'no-cache',
                    'Sec-Fetch-Dest': 'document',
                    'Sec-Fetch-Mode': 'navigate',
                    'Sec-Fetch-Site': 'none',
                    'Upgrade-Insecure-Requests': '1'
                }
                
                # Requête HTTP avec retry automatique
                for attempt in range(3):  # 3 tentatives max
                    try:
                        async with session.get(url, proxy=proxy_config, headers=headers_request, timeout=15) as response:
                            if response.status == 200:
                                html = await response.text()
                                break
                            elif response.status == 503:
                                # Service unavailable - attendre plus longtemps
                                wait_time = random.uniform(2, 5) * (attempt + 1)  # Backoff exponentiel
                                print(f"⚠️ Status 503 - attente {wait_time:.1f}s (tentative {attempt+1})")
                                await asyncio.sleep(wait_time)
                                continue
                            elif response.status == 429:
                                # Rate limit - attendre plus longtemps
                                wait_time = random.uniform(5, 10) * (attempt + 1)
                                print(f"⚠️ Rate limit 429 - attente {wait_time:.1f}s (tentative {attempt+1})")
                                await asyncio.sleep(wait_time)
                                continue
                            else:
                                print(f"❌ Status {response.status} pour {url[:50]}")
                                return None
                    except asyncio.TimeoutError:
                        print(f"⏱️ Timeout {url[:50]} (tentative {attempt+1})")
                        if attempt == 0:
                            await asyncio.sleep(1)
                            continue
                        return None
                    except Exception as e:
                        if "proxy" in str(e).lower() and proxy:
                            self.marquer_proxy_echec(proxy)
                        print(f"❌ Erreur réseau {url[:50]}: {e}")
                        return None
                
                self.stats['total_requests'] += 1
                self.stats['success_requests'] += 1
                
                # Parse HTML avec BeautifulSoup
                soup = BeautifulSoup(html, 'html.parser')
                
                # Extraction des données (même logique que le scraper de base)
                donnees_livre = await self.extraire_donnees_livre(soup, url)
                
                # Statistiques de performance
                temps_livre = time.time() - debut
                self.temps_par_livre_scraping.append(temps_livre)
                
                # Calcul vitesse en temps réel
                temps_total = time.time() - self.stats['start_time']
                if temps_total > 0:
                    self.stats['livres_per_second'] = self.stats['success_requests'] / temps_total
                
                return donnees_livre
                
            except Exception as e:
                self.stats['failed_requests'] += 1
                if proxy:
                    self.marquer_proxy_echec(proxy)
                print(f"❌ Erreur scraping {url[:50]}: {e}")
                return None

    async def extraire_donnees_livre(self, soup: BeautifulSoup, url: str) -> Dict:
        """Extraction ultra-complète et rapide des données livre"""
        donnees_livre = {
            'url': url,
            'timestamp': datetime.now().isoformat(),
            'categorie': self.nom_categorie,
            'titre': '',
            'auteur': '',
            'isbn': '',
            'editeur': '',
            'date_publication': '',
            'langue': '',
            'pages': '',
            'prix_actuel': '',
            'prix_barre': '',
            'description_longue': '',
            'note_moyenne': '',
            'nombre_avis': '',
            'image_url': '',
            'disponibilite': '',
            'categories_breadcrumb': []
        }
        
        # Titre - multiple sélecteurs
        titre_selectors = [
            '#productTitle',
            'h1[data-automation="product-title"]',
            '.a-size-large',
            'h1.a-size-large'
        ]
        for sel in titre_selectors:
            elem = soup.select_one(sel)
            if elem and elem.get_text().strip():
                donnees_livre['titre'] = elem.get_text().strip()
                break
        
        # Auteur
        auteur_selectors = [
            '.author a',
            '[data-automation="byline"] a',
            '.a-link-normal[data-automation="byline"]',
            '#bylineInfo a'
        ]
        auteurs = []
        for sel in auteur_selectors:
            for a in soup.select(sel):
                texte = a.get_text().strip()
                if texte and texte not in auteurs and len(texte) > 1:
                    auteurs.append(texte)
        donnees_livre['auteur'] = ', '.join(auteurs[:3])  # Max 3 auteurs
        
        # Prix
        prix_selectors = [
            '.a-price .a-offscreen',
            '.a-price-whole',
            '#priceblock_dealprice',
            '.a-color-price'
        ]
        for sel in prix_selectors:
            elem = soup.select_one(sel)
            if elem and elem.get_text().strip():
                prix_text = elem.get_text().strip()
                if '€' in prix_text or 'EUR' in prix_text:
                    donnees_livre['prix_actuel'] = prix_text
                    break
        
        # Description
        desc_selectors = [
            '#feature-bullets ul',
            '#bookDescription_feature_div',
            '.a-expander-content',
            '[data-feature-name="bookDescription"] .a-expander-content'
        ]
        for sel in desc_selectors:
            elem = soup.select_one(sel)
            if elem:
                desc_text = elem.get_text().strip()
                if len(desc_text) > 20:  # Description valide
                    donnees_livre['description_longue'] = desc_text[:500]  # Limiter taille
                    break
        
        # ISBN depuis détails produit
        details_text = soup.get_text()
        isbn_match = re.search(r'ISBN[^:]*:\s*([A-Z0-9-]{10,17})', details_text, re.IGNORECASE)
        if isbn_match:
            donnees_livre['isbn'] = isbn_match.group(1)
        
        # Image
        img_selectors = ['#landingImage', '.a-dynamic-image', '#main-image']
        for sel in img_selectors:
            img = soup.select_one(sel)
            if img and img.get('src'):
                donnees_livre['image_url'] = img.get('src')
                break
        
        # Note moyenne
        note_selectors = [
            '[data-hook="average-star-rating"] .a-offscreen',
            '.a-icon-alt',
            '.reviewCountTextLinkedHistogram .a-offscreen'
        ]
        for sel in note_selectors:
            elem = soup.select_one(sel)
            if elem:
                texte = elem.get_text().strip()
                if ('sur 5' in texte.lower() or 'out of 5' in texte.lower()) and any(c.isdigit() for c in texte):
                    donnees_livre['note_moyenne'] = texte
                    break
        
        # Affichage rapide du livre
        titre_court = donnees_livre['titre'][:30] + "..." if len(donnees_livre['titre']) > 30 else donnees_livre['titre']
        print(f"⚡ ASYNC: {titre_court}")
        
        return donnees_livre

    async def scraper_page_async(self, page_num: int) -> List[str]:
        """Scrape une page pour récupérer les URLs des livres"""
        url_page = f"{self.url_base_recherche}&page={page_num}"
        
        session_info = await self.get_session()
        session = session_info['session']
        proxy = session_info['proxy']
        
        try:
            # Headers spéciaux pour les pages de recherche
            headers_search = {
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                'Accept-Language': 'fr-FR,fr;q=0.9',
                'Cache-Control': 'no-cache',
                'Pragma': 'no-cache'
            }
            
            async with session.get(url_page, proxy=proxy, headers=headers_search, timeout=20) as response:
                if response.status != 200:
                    print(f"❌ Page {page_num}: Status {response.status}")
                    return []
                
                html = await response.text()
                soup = BeautifulSoup(html, 'html.parser')
                
                # Extraction des liens livres
                liens_livres = []
                liens_vus = set()
                
                selectors_livres = [
                    'a[href*="/dp/"]',
                    '.s-result-item a[href*="/dp/"]',
                    '[data-component-type="s-search-result"] a[href*="/dp/"]'
                ]
                
                for selector in selectors_livres:
                    for lien in soup.select(selector):
                        href = lien.get('href')
                        if href:
                            if href.startswith('/'):
                                url_complete = urljoin('https://www.amazon.fr', href)
                            else:
                                url_complete = href
                            
                            # Nettoyer URL
                            if '/dp/' in url_complete:
                                dp_index = url_complete.find('/dp/')
                                if dp_index != -1:
                                    base_url = url_complete[:dp_index + 14]  # /dp/ + 10 chars
                                    if base_url not in liens_vus and 'amazon.fr' in base_url:
                                        liens_livres.append(url_complete)
                                        liens_vus.add(base_url)
                
                print(f"📄 Page {page_num}: {len(liens_livres)} livres trouvés")
                return liens_livres
                
        except Exception as e:
            print(f"❌ Erreur page {page_num}: {e}")
            return []

    async def scraper_batch_async(self, urls: List[str]) -> List[Dict]:
        """Scrape un batch d'URLs en parallèle"""
        tasks = []
        for url in urls:
            if url not in self.urls_scrapees:
                task = asyncio.create_task(self.scraper_livre_async(url))
                tasks.append((task, url))
        
        resultats = []
        if tasks:
            # Attendre tous les résultats
            for task, url in tasks:
                try:
                    resultat = await task
                    if resultat:
                        resultats.append(resultat)
                        self.urls_scrapees.add(url)
                except Exception as e:
                    print(f"❌ Erreur task {url[:30]}: {e}")
        
        return resultats

    def creer_dossiers(self):
        """Crée les dossiers nécessaires"""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        os.makedirs(dossier_livres, exist_ok=True)

    def charger_progres(self):
        """Charge les livres existants"""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        
        if os.path.exists(dossier_livres):
            fichiers_json = [f for f in os.listdir(dossier_livres) if f.endswith('.json') and 'progres' not in f]
            for fichier in fichiers_json:
                chemin = os.path.join(dossier_livres, fichier)
                try:
                    with open(chemin, 'r', encoding='utf-8') as f:
                        livres = json.load(f)
                        if isinstance(livres, list):
                            for livre in livres:
                                url = livre.get('url')
                                if url and livre.get('titre'):
                                    self.livres_scraped.append(livre)
                                    self.urls_scrapees.add(url)
                                    self.index_by_url[url] = len(self.livres_scraped) - 1
                            print(f"📚 Chargé: {len(livres)} livres depuis {fichier}")
                except Exception as e:
                    print(f"❌ Erreur lecture {chemin}: {e}")
        
        print(f"📚 Total chargé: {len(self.livres_scraped)} livres existants")

    async def sauvegarder_progres_async(self, page_actuelle: int = 1):
        """Sauvegarde asynchrone des données"""
        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        dossier_livres = os.path.join(base_dir, 'LIVRES', self.nom_fichier)
        
        # Sauvegarde JSON
        fichier_json = os.path.join(dossier_livres, f"{self.nom_fichier}_livres.json")
        try:
            async with aiofiles.open(fichier_json, 'w', encoding='utf-8') as f:
                await f.write(json.dumps(self.livres_scraped, ensure_ascii=False, indent=2))
            print(f"💾 JSON sauvé: {len(self.livres_scraped)} livres")
        except Exception as e:
            print(f"❌ Erreur sauvegarde JSON: {e}")
        
