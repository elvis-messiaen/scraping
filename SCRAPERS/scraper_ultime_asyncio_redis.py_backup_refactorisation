    def formater_duree(self, secondes: float) -> str:
        """Formate une durée en format lisible"""
        if secondes < 60:
            return f"{secondes:.1f}s"
        elif secondes < 3600:
            minutes = int(secondes // 60)
            sec_restantes = secondes % 60
            return f"{minutes}m {sec_restantes:.0f}s"
        else:
            heures = int(secondes // 3600)
            minutes = int((secondes % 3600) // 60)
            return f"{heures}h {minutes}m"

    def calculer_estimation_temps(self, livres_traites: int, total_livres: int, temps_historique: List[float]) -> Tuple[str, str]:
        """Calcule l'estimation de temps restant"""
        if not temps_historique or livres_traites == 0:
            return "Calcul...", "Calcul..."
        
        # Temps moyen des 20 derniers livres pour plus de précision
        derniers_temps = temps_historique[-20:]
        temps_moyen = sum(derniers_temps) / len(derniers_temps)
        
        temps_ecoule = time.time() - self.stats['start_time']
        livres_restants = total_livres - livres_traites
        temps_restant = livres_restants * temps_moyen
        
        return self.formater_duree(temps_ecoule), self.formater_duree(temps_restant)

    def afficher_stats_temps_reel(self):
        """Affiche les statistiques en temps réel"""
        temps_total = time.time() - self.stats['start_time']
        taux_succes = (self.stats['success_requests'] / self.stats['total_requests'] * 100) if self.stats['total_requests'] > 0 else 0
        
        print(f"\033[92m⚡ STATS ULTRA-RAPIDE:\033[0m")
        print(f"   📊 Requêtes: {self.stats['total_requests']} | Succès: {taux_succes:.1f}%")
        print(f"   🚀 Vitesse: {self.stats['livres_per_second']:.1f} livres/seconde")
        print(f"   🔄 Rotations proxy: {self.stats['proxy_rotations']}")
        print(f"   ⏱️ Temps total: {self.formater_duree(temps_total)}")

    async def run_async(self):
        """Fonction principale asynchrone"""
        print("🚀 DÉMARRAGE SCRAPER ULTIME ASYNCIO + REDIS")
        print("=" * 60)
        
        self.stats['start_time'] = time.time()
        self.temps_debut_scraping = time.time()
        
        # 1. Détection du total
        total_amazon = self.detecter_total_amazon_actuel()
        print(f"🎯 Objectif: {total_amazon:,} livres")
        print(f"📚 Existants: {len(self.livres_scraped):,} livres")
        
        # 2. Créer le pool de sessions
        await self.create_session_pool()
        
        # 3. Scraping par pages avec AsyncIO
        page_actuelle = 1
        nouveaux_livres_session = 0
        
        try:
            while nouveaux_livres_session < (total_amazon - len(self.livres_scraped)) and page_actuelle <= 10:  # Test sur 10 pages max
                # Récupérer les URLs de la page
                urls_page = await self.scraper_page_async(page_actuelle)
                
                if not urls_page:
                    print(f"❌ Page {page_actuelle}: Aucun livre trouvé")
                    break
                
                # Scraper les livres en parallèle
                nouveaux_livres = await self.scraper_batch_async(urls_page)
                
                if nouveaux_livres:
                    self.livres_scraped.extend(nouveaux_livres)
                    nouveaux_livres_session += len(nouveaux_livres)
                    
                    # Mise à jour des index
                    for livre in nouveaux_livres:
                        url = livre.get('url')
                        if url:
                            self.index_by_url[url] = len(self.livres_scraped) - 1
                    
                    # Calcul des estimations
                    temps_ecoule, temps_restant = self.calculer_estimation_temps(
                        len(self.livres_scraped), total_amazon, self.temps_par_livre_scraping
                    )
                    
                    # Statistiques
                    pourcentage = (len(self.livres_scraped) / total_amazon * 100) if total_amazon > 0 else 0
                    
                    print(f"\n📊 PAGE {page_actuelle} TERMINÉE:")
                    print(f"   ✅ +{len(nouveaux_livres)} nouveaux livres")
                    print(f"   📚 Total: {len(self.livres_scraped):,} livres ({pourcentage:.1f}%)")
                    print(f"   ⏱️ Temps: {temps_ecoule} | Restant: {temps_restant}")
                    
                    # Affichage stats temps réel
                    self.afficher_stats_temps_reel()
                    
                    # Sauvegarde asynchrone
                    await self.sauvegarder_progres_async(page_actuelle)
                
                page_actuelle += 1
                
                # Délai entre pages
                await asyncio.sleep(random.uniform(0.5, 1.5))
        
        except KeyboardInterrupt:
            print("\n🛑 Arrêt demandé par l'utilisateur")
        
        finally:
            # Sauvegarde finale
            await self.sauvegarder_progres_async(page_actuelle)
            
            # Fermeture des sessions
            for session_info in self.session_pool:
                await session_info['session'].close()
            
            # Stats finales
            temps_total = time.time() - self.stats['start_time']
            print(f"\n🏁 SCRAPING TERMINÉ:")
            print(f"   📚 Total final: {len(self.livres_scraped):,} livres")
            print(f"   ⏱️ Temps total: {self.formater_duree(temps_total)}")
            print(f"   🚀 Vitesse moyenne: {len(self.livres_scraped) / temps_total * 60:.1f} livres/minute")
            taux_succes = (self.stats['success_requests'] / self.stats['total_requests'] * 100) if self.stats['total_requests'] > 0 else 0
            print(f"   ✅ Taux de succès: {taux_succes:.1f}%")

    def run(self):
        """Point d'entrée synchrone"""
        try:
            # Lancer l'event loop AsyncIO
            asyncio.run(self.run_async())
        except KeyboardInterrupt:
            print("\n🛑 Arrêt du scraper")
        except Exception as e:
            print(f"❌ Erreur critique: {e}")
            import traceback
            traceback.print_exc()

